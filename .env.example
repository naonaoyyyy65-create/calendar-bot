LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account.json
# カレンダー更新チェックの永続化先（PropertiesService相当、gitには含めない）
DATA_FILE_PATH=./data/store.json
PORT=3001

# 任意: 作成者情報（未設定でも動作するが、担当者別の色分け・凡例が使えなくなる）。
# CREATOR1/2_LINE_USER_IDは、月間カレンダー/今日の予定/変更通知の本番プッシュ送信先
# （NOTIFY_USER_IDS＝この2人）としても使われる。デバッグ実行（--debug）時はCREATOR1のみに送信。
CREATOR1_EMAIL=
CREATOR1_NAME=
CREATOR1_LINE_USER_ID=
CREATOR1_COLOR_ID=
CREATOR2_EMAIL=
CREATOR2_NAME=
CREATOR2_LINE_USER_ID=
CREATOR2_COLOR_ID=
