{
  "name": "calendar-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Googleカレンダー連携LINE Bot",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "send-monthly-calendar": "node src/sendMonthlyCalendar.js",
    "send-today-schedule": "node src/sendTodaySchedule.js",
    "check-calendar-updates": "node src/checkCalendarUpdates.js",
    "test": "node --experimental-test-module-mocks --test",
    "test:coverage": "node --experimental-test-module-mocks --test --experimental-test-coverage",
    "lint": "eslint ."
  },
  "dependencies": {
    "@line/bot-sdk": "^11.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "latest"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0"
  }
}
