[Unit]
Description=Calendar LINE Bot (Node.js)
After=network.target

[Service]
Type=simple
User=<user>
WorkingDirectory=/home/<user>/apps/calendar-bot
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
EnvironmentFile=/home/<user>/apps/calendar-bot/.env

[Install]
WantedBy=multi-user.target
